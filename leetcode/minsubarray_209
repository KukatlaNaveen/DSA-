#  209 given array of positive integer nums and positive integer target return the minimul length subarray whose 
# sum is greater than are equal to  target if ther is no such subarray return 0 instead


def min_subarray(nums,target):
   n=len(nums)
   min_len=n+1
   start=0
   current_sum=0
   for end in range(n):
       current_sum+=nums[end]
       while current_sum>=target:
         min_len=min(min_len,end-start+1)
         current_sum-=nums[start]
         start+=1
   if min_len!=n+1:
     return min_len
   else:
     return 0
nums=[1,4,4]
target=4
print(min_subarray(nums,target))

# 643   you are given an integer nums consisting n elements an integer k
# find a contiguos array whose subarray lenth is equal to k that has the maximal length


def max_avg(arr,k):
    current_sum=sum(arr[:k])
    max_sum=current_sum
    n=len(arr)
    for i in range(k,n):
        current_sum=current_sum-arr[i-k]+arr[i]
        
        if current_sum>max_sum:
          max_sum=current_sum
    return max_sum/(1.0*k)
arr=[1,12,-5,-6,50,3]
k=4
print(max_avg(arr,k))
